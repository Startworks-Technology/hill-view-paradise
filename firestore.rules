rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated admin or manager
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user has media or admin role
    function isMediaOrAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'media' ||
        request.auth.token.isAdmin == true
      );
    }

    // Rules for Residents collection
    // Public read for everyone; write restricted to authenticated admin
    match /residents/{residentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for Collections (Maintenance payments)
    // Public read for everyone; write restricted to authenticated admin
    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for Expenses collection
    // Public read for everyone; write restricted to authenticated admin
    match /expenses/{expenseId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for Gallery (Photos & Videos metadata with S3 links)
    // Public read for all residents and visitors; write restricted to Admin and Media roles
    match /gallery/{mediaId} {
      allow read: if true;
      allow write: if isMediaOrAdmin();
    }

    // Rules for Users collection (Mobile / Email accounts with roles)
    // Read allowed for login resolution; write restricted to authenticated admin
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for Monthly Billing Logs (Maintenance dues audit trails)
    // Public read for everyone; write restricted to authenticated admin
    match /billing_logs/{logId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
