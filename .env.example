# ==============================================================================
# Hill View Paradise - Environment Configuration Template
# Copy this file to .env and fill in your credentials
# ==============================================================================

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# AWS S3 Storage Configuration (Media Gallery)
VITE_AWS_REGION=ap-south-1
VITE_AWS_S3_BUCKET=your-s3-bucket-name
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key_id
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Optional: Amazon CloudFront CDN Domain (Leave empty to use direct S3 URLs)
# Example: d1234567890abcdef.cloudfront.net or media.hillviewparadise.com
VITE_AWS_CLOUDFRONT_DOMAIN=
